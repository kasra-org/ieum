(logging) {
    log stdoutlogger {
        output stdout
    }
    log filelogger {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 10
            roll_keep_for 72h
        }
    }
}

:80 {
    import logging
    reverse_proxy /* frontend:3000
    reverse_proxy /{$DJANGO_ADMIN_PAGE_NAME:djangoadmin}/* backend:8080
    reverse_proxy /accounts/* backend:8080
    reverse_proxy /nicepay/callback backend:8080
    reverse_proxy /_allauth/browser/v1/auth/provider/redirect backend:8080
    reverse_proxy /_allauth/browser/v1/account/providers backend:8080
    reverse_proxy /_allauth/browser/v1/account/email backend:8080
    handle_path /static/* {
        root * /www/static
        file_server
    }
    handle_path /media/* {
        # Abstract files go only to their author and the event's admins; the
        # backend decides from the session cookie (authorize_abstract_file).
        forward_auth /abstracts/* backend:8080 {
            uri /api/media-auth/abstract
            # The same Host the frontend's API calls use, so ALLOWED_HOSTS
            # does not depend on which name the visitor came in by.
            header_up Host {upstream_hostport}
        }
        root * /www/media
        file_server
    }
}
